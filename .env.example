# Copy this file to .env and fill in the values for your environment.
# See README.md §Configuration for details on each variable.

# Stellar network: "public" or "testnet"
STELLAR_NETWORK=testnet

# Horizon endpoint for on-chain delivery data
HORIZON_URL=https://horizon-testnet.stellar.org

# Optional transaction-analytics-api base URL
# ANALYTICS_API_URL=

# Storage for runs, scenarios and reports
# DATABASE_URL=
